{
  "manifest_version": 3,
  "name": "PP Planering – bemanningsöversikt",
  "short_name": "PP Planering",
  "version": "0.1.0",
  "description": "Långtidsplanering för stora projekt i Projektportalen: kvarvarande timmar mot slutdatum, uppmanningsbehov och kapacitet. Läser endast data.",
  "permissions": ["storage", "scripting", "tabs"],
  "host_permissions": [
    "https://new-app.projektportalen.se/*",
    "https://new-api.projektportalen.se/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Öppna PP Planering",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_scripts": [
    {
      "matches": ["https://new-app.projektportalen.se/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
